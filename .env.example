NODE_ENV=production
PORT=3000
SITE_DOMAIN=uno.example.com
PUBLIC_ORIGIN=https://uno.example.com

# Optional WebRTC TURN relay. Comma-separate multiple TURN/TURNS URLs.
DBT_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp

# Preferred: coturn REST/use-auth-secret compatible shared secret.
# The server derives short-lived HMAC-SHA1 credentials; this value is never sent to browsers.
DBT_TURN_SHARED_SECRET=
DBT_TURN_TTL_SECONDS=900

# Backward-compatible fallback for providers that issue fixed credentials.
DBT_TURN_USERNAME=
DBT_TURN_CREDENTIAL=
