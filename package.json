{
  "name": "uno-duel",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/main.ts",
    "build": "tsc && npm test",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write src client tests README.md package.json tsconfig.json compose.yaml"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "prettier": "^3.9.6",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
